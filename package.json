{
  "name": "rasante",
  "version": "0.1.0",
  "description": "RASANTE — juego arcade 2D de vuelo rasante en Malvinas 1982. Migración a Electron para Steam.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "serve": "python3 -m http.server 8475",
    "build:game": "esbuild src/game.js --bundle --format=iife --outfile=src/game.bundle.js",
    "prestart": "npm run build:game",
    "start": "electron .",
    "smoke": "electron tools/smoke.js",
    "feel": "node tools/feeltest.js",
    "syntax": "python3 tools/check_syntax.py",
    "unit": "node --test tools/unit.js",
    "story": "electron tools/fixture_story.js",
    "pasada": "electron tools/fixture_pasada.js",
    "pulso": "electron tools/fixture_pulso.js",
    "caza": "electron tools/fixture_caza.js",
    "romper": "electron tools/fixture_romper.js",
    "lint:state": "node tools/lint_state.js",
    "check": "npm run syntax && npm run lint:state && npm run build:game && npm run unit && npm run feel && npm run smoke && npm run build:web && SMOKE_SRC=\"$PWD/dist-web/index.html\" npm run smoke:web",
    "build:three": "esbuild tools/three-entry.mjs --bundle --format=iife --global-name=THREE --minify --legal-comments=none --outfile=src/vendor/three.global.js",
    "build:web": "python3 tools/build_web.py",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "prebuild:web": "npm run build:game",
    "predist": "npm run build:game",
    "prepack": "npm run build:game",
    "smoke:web": "electron tools/smoke.js",
    "agua": "electron tools/fixture_agua.js"
  },
  "author": "Matias Luna",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.matiasluna.rasante",
    "productName": "RASANTE",
    "copyright": "© 2026 Matias Luna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/planes/**/*",
      "assets/ui/**/*",
      "assets/world/**/*",
      "assets/photos/**/*",
      "assets/fonts/**/*",
      "assets/music/**/*",
      "!assets/music/web/**/*",
      "assets/sfx/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RASANTE-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RASANTE-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
